{
  "name": "nota-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "seed": "tsx prisma/seed.ts",
    "test": "npm run test:sync && npm run test:importer",
    "test:sync": "tsx src/services/__tests__/syncEngine.test.ts",
    "test:importer": "tsx src/services/__tests__/testImporter.ts",
    "test:endpoints": "tsx src/services/__tests__/verifyEndpoints.ts"
  },
  "dependencies": {
    "@clerk/express": "^1.3.48",
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.3",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
